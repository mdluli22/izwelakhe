# Public origin used for metadata and sitemap generation at build time
SITE_URL=https://izwelakheconsulting.co.za

# Business WhatsApp number with country code, digits only. Set before building.
# The floating WhatsApp button becomes a live chat link when configured.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# SMTP credentials must be supplied in your private .env file or deployment secrets
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=Izwelakhe Website <info@izwelakheconsulting.co.za>
